<section class="neuroshima-disease-sheet" style="height: 100%; overflow-y: auto; padding-right: 6px;">
  <header>
    <label>Nazwa choroby <input type="text" name="name" value="{{item.name}}"></label>
  </header>

  <label>Aktualny etap
    <select name="system.currentStage">
      {{selectOptions diseaseStageOptions selected=system.currentStage}}
    </select>
  </label>

  <label>
    <input type="checkbox" name="system.applyMechanicalEffects" {{checked system.applyMechanicalEffects}}>
    Uwzględniaj mechaniczne skutki aktualnego etapu w testach i wyliczeniach
  </label>

  <label>Opis choroby
    <textarea name="system.description" rows="8">{{system.description}}</textarea>
  </label>

  <h2>Etapy choroby</h2>
  {{#each stageEntries}}
    <fieldset>
      <legend>{{this.label}}</legend>
      <label>Dodatkowe zasady opisowe
        <textarea name="system.stages.{{this.key}}.summary" rows="2">{{this.stage.summary}}</textarea>
      </label>
      <label>Opis etapu
        <textarea name="system.stages.{{this.key}}.description" rows="5">{{this.stage.description}}</textarea>
      </label>
      <p><strong>Premie i utrudnienia:</strong></p>
      <button type="button" data-action="addStageModifier" data-stage-key="{{this.key}}">Dodaj zmianę</button>
      {{#if this.mechanicalEffects.length}}
        <ul>
          {{#each this.mechanicalEffects}}
            <li>
              {{this.label}}
              <button type="button" data-action="editStageModifier" data-stage-key="{{../key}}" data-modifier-index="{{this.index}}">Edytuj</button>
              <button type="button" data-action="deleteStageModifier" data-stage-key="{{../key}}" data-modifier-index="{{this.index}}">Usuń</button>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p><small>Brak zmian liczbowych na tym etapie.</small></p>
      {{/if}}
      {{#if this.unsupportedEffects.length}}
        <p><small>Nierozpoznane stare wpisy: {{#each this.unsupportedEffects}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</small></p>
      {{/if}}
      <details>
        <summary>Dane techniczne starszego importu</summary>
        <label>Surowy kod efektu
          <input type="text" name="system.stages.{{this.key}}.effect" value="{{this.stage.effect}}">
        </label>
      </details>
    </fieldset>
  {{/each}}

  <h2>Leczenie</h2>
  <h3>Powiązane leki</h3>
  {{#if linkedMedicines.length}}
    <ul>
      {{#each linkedMedicines}}
        <li><strong>{{this.name}}</strong></li>
      {{/each}}
    </ul>
  {{else}}
    <p>Brak konkretnych leków powiązanych w katalogu.</p>
  {{/if}}

  <label>Opis leków i leczenia
    <textarea name="system.medicationDescription" rows="6">{{system.medicationDescription}}</textarea>
  </label>

  <label>Kod źródłowy
    <input type="text" name="system.sourceCode" value="{{system.sourceCode}}" readonly>
  </label>
</section>
