<section class="neuroshima-weapon-sheet" style="height: 100%; overflow-y: auto; padding-right: 6px;">
  <header>
    <label>
      Nazwa broni
      <input type="text" name="name" value="{{item.name}}">
    </label>
  </header>

  <h2>Broń</h2>

  <label>
    Klasa broni
    <select name="system.weaponClass">
      {{selectOptions weaponClassOptions selected=system.weaponClass}}
    </select>
  </label>

  <label>
    Rodzina amunicji
    <input
      type="text"
      name="system.ammunitionCode"
      value="{{system.ammunitionCode}}"
      list="{{ammunitionCompatibilityListId}}"
      placeholder="Wybierz albo wpisz nowy symbol"
    >
  </label>
  <datalist id="{{ammunitionCompatibilityListId}}">
    {{#each ammunitionCompatibilityOptions}}
      <option value="{{this.value}}">{{this.label}}</option>
    {{/each}}
  </datalist>
  <small>Broń przyjmie każdy wariant amunicji należący do tej rodziny.</small>

  <h3>Kompatybilna amunicja</h3>
  {{#unless ammunitionRelations.ammunitionSymbol}}
    <p>Ustaw rodzinę amunicji, aby zobaczyć powiązane wpisy.</p>
  {{else}}
    {{#if ammunitionRelations.actorItems.length}}
      <h4>Zapasy tej postaci</h4>
      <ul>
        {{#each ammunitionRelations.actorItems}}
          <li>
            <button type="button" data-action="openRelatedItem"
              data-related-source="{{this.source}}" data-related-item-id="{{this.id}}">
              {{this.name}}
            </button>
            — {{this.details}}
          </li>
        {{/each}}
      </ul>
    {{/if}}
    <h4>W Kompendium</h4>
    {{#if ammunitionRelations.catalogItems.length}}
      <ul>
        {{#each ammunitionRelations.catalogItems}}
          <li>
            <button type="button" data-action="openRelatedItem"
              data-related-source="{{this.source}}" data-related-pack-id="{{this.packId}}"
              data-related-item-id="{{this.id}}">
              {{this.name}}
            </button>
            — {{this.details}}
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p>{{#if ammunitionRelations.compendiumAvailable}}Brak wariantów tej rodziny.{{else}}Compendium amunicji nie jest dostępne.{{/if}}</p>
    {{/if}}
  {{/unless}}

  <h3>Magazynek</h3>

  <label>
    Pojemność magazynka
    <input type="number" name="system.magazineCapacity" value="{{system.magazineCapacity}}" min="0" step="1">
  </label>

  <label>
    Aktualna liczba nabojów
    <input type="number" name="system.currentAmmunition" value="{{system.currentAmmunition}}" min="0" max="{{system.magazineCapacity}}" step="1">
  </label>

  {{!-- Te wartości są uzupełniane automatycznie podczas przeładowania. --}}
  <p><strong>Załadowany wariant:</strong> {{system.loadedAmmunitionSourceCode}}</p>
  <p><strong>Masa amunicji w magazynku:</strong> {{system.loadedAmmunitionWeight}} kg</p>

  <h3>Parametry strzału</h3>

  <label>
    Próg niezawodności
    <input type="number" name="system.misfireRoll" value="{{system.misfireRoll}}" min="1" max="20" step="1">
  </label>
  <small>Naturalny wynik strzału równy lub niższy jest bezpieczny. Wyższy uruchamia rzut na zacięcie.</small>

  <label>
    Stan broni
    <select name="system.jamState">
      {{selectOptions jamStateOptions selected=system.jamState}}
    </select>
  </label>
  <p><strong>Ostatni rzut na zacięcie:</strong> {{system.jamSeverityRoll}}</p>

  <label>
    Modyfikator celności w procentach
    <input type="number" name="system.accuracyModifier" value="{{system.accuracyModifier}}" step="1">
  </label>

  <label>
    Zasięg w metrach
    <input type="number" name="system.range" value="{{system.range}}" min="0" step="1">
  </label>

  <label>
    Szybkostrzelność
    <input type="number" name="system.fireRate" value="{{system.fireRate}}" min="1" step="1">
    <small>Dla trybu A: X nabojów w krótkiej serii; długa seria 3X, ogień ciągły 6X.</small>
  </label>

  <label>
    Rodzaje ataku
    <input type="text" name="system.attackTypes" value="{{system.attackTypes}}" placeholder="np. S,A">
  </label>
  <small>Rozpoznane rodzaje: {{attackTypeDescription}}</small>

  <label>
    Czas przeładowania w segmentach (0 = ustala MG)
    <input type="number" name="system.reloadTime" value="{{system.reloadTime}}" min="0" step="1">
  </label>

  <fieldset>
    <legend>Obsługa egzemplarza</legend>
    <label>Wymagane dłonie <input type="number" name="system.requiredHands" value="{{system.requiredHands}}" min="1" max="2" step="1"></label>
    <label><input type="checkbox" name="system.requiresPreparation" {{checked system.requiresPreparation}}> MG wymaga dodatkowego przygotowania przed strzałem (2 segmenty)</label>
    <label>Na czym polega dodatkowe przygotowanie? <input type="text" name="system.preparationDescription" value="{{system.preparationDescription}}" placeholder="Opisz czynność wymaganą dla tego egzemplarza"></label>
    <label><input type="checkbox" name="system.prepared" {{checked system.prepared}}> Dodatkowe przygotowanie wykonane (istotne tylko przy zaznaczonym wymogu powyżej)</label>
    <label><input type="checkbox" name="system.safetyOn" {{checked system.safetyOn}}> Zabezpieczona</label>
    <label><input type="checkbox" name="system.requiresCycling" {{checked system.requiresCycling}}> Po strzale wymaga ręcznego przeładowania mechanizmu</label>
    <label><input type="checkbox" name="system.needsCycling" {{checked system.needsCycling}}> Obecnie wymaga przeładowania mechanizmu</label>
    <p><small>Zwykła broń nie wymaga osobnego „Przygotuj”: jeśli jest w dłoni, załadowana, sprawna i odbezpieczona, można strzelać. Wymóg dodatkowego przygotowania włączaj tylko dla świadomie ustalonego wyjątku. Podczas walki używaj przycisków na karcie postaci, aby rozliczać czas.</small></p>
  </fieldset>

  <label>
    Punkty przebicia pancerza
    <input type="number" name="system.armorPenetration" value="{{system.armorPenetration}}" min="0" step="1">
  </label>

  <label>
    Obrażenia
    <select name="system.damageCode">
      {{selectOptions damageOptions selected=system.damageCode}}
    </select>
  </label>

  <label>
    Wymagana Budowa
    <input type="number" name="system.requiredStrength" value="{{system.requiredStrength}}" min="0" step="1">
  </label>

  <h3>Pozostałe dane</h3>

  <label>
    Kod kabury
    <input type="text" name="system.holsterCode" value="{{system.holsterCode}}" placeholder="np. P albo N">
  </label>

  <label>
    Masa
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.01">
  </label>

  <label>
    Jednostka masy
    <select name="system.weightUnit">
      {{selectOptions weightUnitOptions selected=system.weightUnit}}
    </select>
  </label>

  <p><strong>Łączna masa broni z amunicją:</strong> {{system.totalWeight}} kg</p>

  <label>
    Cena
    <input type="number" name="system.price" value="{{system.price}}" min="0" step="0.01">
  </label>

  <label>
    Dostępność w procentach
    <input type="number" name="system.availability" value="{{system.availability}}" min="0" max="100" step="1">
  </label>

  <label>
    Kod źródłowy (automatyczny)
    <input type="text" name="system.sourceCode" value="{{system.sourceCode}}" readonly>
  </label>

  <label>
    Akcje specjalne
    <input type="text" name="system.actions" value="{{system.actions}}">
  </label>

  <label>
    Opis
    <textarea name="system.description" rows="8">{{system.description}}</textarea>
  </label>
</section>
