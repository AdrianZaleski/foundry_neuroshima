<section class="neuroshima-equipment-sheet" style="height: 100%; overflow-y: auto; padding-right: 6px;">
  <header>
    <label>
      Nazwa przedmiotu
      <input type="text" name="name" value="{{item.name}}">
    </label>
  </header>

  <h2>Zwykły ekwipunek</h2>

  <label>
    Liczba sztuk
    <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" step="1">
  </label>

  <label>
    Masa jednej sztuki
    <input type="number" name="system.unitWeight" value="{{system.unitWeight}}" min="0" step="0.01">
  </label>

  {{!-- Łączna masa jest tylko wyświetlana, ponieważ oblicza ją model danych. --}}
  <output>Łączna masa: {{system.totalWeight}}</output>

  <label>
    Cena
    <input type="number" name="system.price" value="{{system.price}}" min="0" step="0.01">
  </label>

  <label>
    Opis
    <textarea name="system.description" rows="8">{{system.description}}</textarea>
  </label>
</section>
