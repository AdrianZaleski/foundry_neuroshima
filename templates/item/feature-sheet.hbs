<section class="neuroshima-feature-sheet" style="height: 100%; overflow-y: auto; padding-right: 6px;">
  <header>
    <label>
      Nazwa
      <input type="text" name="name" value="{{item.name}}">
    </label>
  </header>

  <h2>{{featureTypeName}}</h2>
  {{#if skillGroupOptions}}
    <label>Pakiet Umiejętności (+2 do każdej)
      <select name="system.selectedSkillGroup">{{selectOptions skillGroupOptions selected=system.selectedSkillGroup}}</select>
    </label>
    <p>Zmiana pakietu przenosi premię bez zmiany wartości bazowych.</p>
  {{/if}}
  <label>Ograniczenie płci wynikające z zasad
    <select name="system.requiredGender">{{selectOptions genderOptions selected=system.requiredGender}}</select>
  </label>
  {{#if hasGenderRequirement}}
    <p>Efekt wymaga zgodnej płci na karcie postaci. Doktor Quinn zawsze wymaga kobiety.</p>
    <label><input type="checkbox" name="system.ignoreGenderRequirement" {{checked system.ignoreGenderRequirement}}> MG zezwolił na działanie mimo wymogu płci</label>
  {{/if}}
  <label><input type="checkbox" name="system.applyMechanicalEffects" {{checked system.applyMechanicalEffects}}> Naliczaj rozpoznane premie automatycznie</label>

  <label>
    Zestaw zasad
    <input type="text" name="system.ruleset" value="{{system.ruleset}}">
  </label>

  <label>
    Wymagania
    <textarea name="system.requirements" rows="3">{{system.requirements}}</textarea>
  </label>

  <label>
    Działanie
    <textarea name="system.effects" rows="7">{{system.effects}}</textarea>
  </label>

  <label>
    Opis
    <textarea name="system.description" rows="7">{{system.description}}</textarea>
  </label>

  {{!-- Kod źródłowy jest widoczny diagnostycznie, lecz powstaje automatycznie. --}}
  <p><small>Kod źródłowy: {{system.sourceCode}}</small></p>
</section>
