<section class="tab {{tabs.main.cssClass}} ns-sheet-tab" data-group="sheet" data-tab="main">
  <div class="ns-action-toolbar">
    <button class="ns-primary-action" type="button" data-action="rollInitiative" {{#if consciousness.unconscious}}disabled{{/if}}><i class="fa-solid fa-dice-d20"></i> Rzuć inicjatywę</button>
    {{#if canManageMelee}}
      <button type="button" data-action="meleeDuel"><i class="fa-solid fa-hand-fist"></i> Pojedynek wręcz (MG)</button>
    {{/if}}
    {{#if canUseMeleePlayerPanel}}
      <button class="ns-primary-action" type="button" data-action="meleePlayerPanel"><i class="fa-solid fa-hand-fist"></i> Decyzje pojedynku</button>
    {{/if}}
    <button class="ns-diagnostic" type="button" data-action="downloadCombatDiagnostics"><i class="fa-solid fa-file-arrow-down"></i> Diagnostyka</button>
  </div>

  {{#if combatStatus.inCombat}}
    <section class="ns-panel ns-combat-panel">
      <h2>Walka</h2>
      {{#if combatStatus.started}}
        <p><strong>Runda {{combatStatus.round}} — segment {{combatStatus.segment}} z 3</strong></p>

        {{#if combatStatus.action.isCurrent}}
          <p>
            Akcja: <strong>{{combatStatus.action.name}}</strong>
            (koszt: {{combatStatus.action.durationLabel}})
          </p>
          {{#if combatStatus.action.canResolveShot}}
            <button type="button" data-action="resolveSingleShot">{{combatStatus.action.resolveShotLabel}}</button>
          {{/if}}
          {{#if combatStatus.action.canResolveHandling}}
            <button type="button" data-action="resolveWeaponHandling">Dokończ obsługę broni</button>
          {{/if}}
          {{#if combatStatus.action.canConfigureAiming}}
            <button type="button" data-action="configureAiming">Wybierz broń i cel strzału</button>
          {{/if}}
          {{#if combatStatus.action.canCancelUnconfiguredShot}}
            <button type="button" data-action="cancelUnconfiguredShot">Cofnij deklarację strzału</button>
          {{/if}}
          {{#if combatStatus.action.canConfigureJamClearing}}
            <button type="button" data-action="configureJamClearing">Wybierz broń z lekkim zacięciem</button>
          {{/if}}
          {{#if combatStatus.action.aimingConfiguration}}
            <p>
              Strzał: <strong>{{combatStatus.action.aimingConfiguration.weaponName}}</strong>
              → <strong>{{combatStatus.action.aimingConfiguration.targetName}}</strong>
            </p>
          {{/if}}
          {{#if combatStatus.action.jamClearingConfiguration}}
            <p>
              Usuwanie zacięcia: <strong>{{combatStatus.action.jamClearingConfiguration.weaponName}}</strong>
            </p>
          {{/if}}
          {{#if combatStatus.action.resolution}}
            <p><strong>Rozstrzygnięcie:</strong> {{combatStatus.action.resolution}}</p>
          {{/if}}
          <p>{{combatStatus.action.timingDescription}}</p>
          {{#if combatStatus.action.burstDescription}}<p>{{combatStatus.action.burstDescription}}</p>{{/if}}
          <p>
            {{#if combatStatus.action.requiresTest}}
              Rozstrzygnięcie wymaga testu.
            {{else}}
              Akcja nie wymaga testu.
            {{/if}}
          </p>
          {{#if combatStatus.action.canFinishEarly}}
            <button type="button" data-action="finishSegmentAction">{{combatStatus.action.finishEarlyLabel}}</button>
          {{/if}}
          {{#if combatStatus.action.canInterrupt}}
            <button type="button" data-action="interruptSegmentAction">{{combatStatus.action.interruptLabel}}</button>
          {{/if}}
          {{#if combatStatus.action.canAdvanceAfterAction}}
            <button type="button" data-action="advanceAfterSegmentAction">Zakończ udział w segmencie</button>
          {{/if}}
        {{else}}
          {{#if combatStatus.canDeclareAction}}
            <button type="button" data-action="declareSegmentAction">Zadeklaruj akcję</button>
            <button type="button" data-action="passSegment">Pas</button>
          {{else}}
            {{#if combatStatus.isActiveTurn}}
              {{#if consciousness.unconscious}}<p>Postać jest nieprzytomna. Przejdź dalej w Trackerze; działania wymagają zdjęcia statusu przez MG.</p>{{else}}<p>Rozlicz rundę walki wręcz w panelu MG.</p>{{/if}}
            {{else}}
              <p>Postać czeka na swój moment w tym segmencie.</p>
            {{/if}}
          {{/if}}
        {{/if}}
      {{else}}
        <p>Postać jest w Combat Trackerze. Rozpocznij walkę po ustaleniu Inicjatywy.</p>
      {{/if}}
    </section>
  {{/if}}

  {{#if quickWeaponGuidance.length}}
    <section class="ns-weapon-guide">
      <h2>Broń — co dalej?</h2>
      <p class="ns-weapon-guide-intro">Wykonuj tylko wskazany następny krok. Broń w dłoni z amunicją nie wymaga osobnego „Przygotuj”, chyba że MG ustawił dodatkowy wymóg.</p>
      {{#each quickWeaponGuidance}}
        <article class="ns-weapon-guide-card">
          <div><strong>{{this.name}}</strong> <span>{{this.locationLabel}} · {{this.ammunition}} nabojów</span></div>
          <p class="ns-weapon-readiness">{{this.readinessLabel}}</p>
          {{#if this.unavailable}}<p class="ns-weapon-blocker">{{this.unavailable}}</p>{{else}}<p>{{this.next.explanation}}</p>{{/if}}
          <div class="ns-weapon-next"><button class="ns-primary-action" type="button" data-action="nextWeaponStep" data-item-id="{{this.id}}" {{#if this.disabled}}disabled{{/if}}>{{this.next.label}}</button><small>{{this.cost}}</small></div>
          {{#if this.steps.length}}<details data-sync="weapon-guide-{{this.id}}"><summary>Kolejność pozostałych czynności</summary><ol>{{#each this.steps}}<li><strong>{{this.label}}</strong>{{#if this.duration}} ({{this.duration}} seg.){{/if}} — {{this.explanation}}</li>{{/each}}<li>Strzel — wybierz cel i ewentualne celowanie.</li></ol></details>{{/if}}
        </article>
      {{/each}}
    </section>
  {{/if}}

  <div class="ns-dossier-grid">
    <section class="ns-panel ns-attributes-panel">
      <div class="ns-section-heading"><h2>Współczynniki</h2><small>Test 3k20</small></div>
      <table class="ns-attribute-matrix">
        <thead><tr>
          {{#each attributeColumns}}<th scope="col"><button type="button" class="ns-attribute-roll" data-action="rollAttribute" data-attribute="{{key}}" title="Test: {{label}}" aria-label="Test: {{label}}">{{abbreviation}}</button><span class="ns-attribute-label">{{label}}</span></th>{{/each}}
          <th scope="col" class="ns-matrix-label">Współczynnik</th>
        </tr></thead>
        <tbody>
          <tr class="ns-base-row">{{#each attributeColumns}}<td><input type="number" name="system.attributes.{{key}}.base" value="{{base}}" min="1" max="40" step="1" aria-label="{{label}} — baza"></td>{{/each}}<th scope="row">Baza</th></tr>
          <tr class="ns-modifier-row">{{#each attributeColumns}}<td><input type="number" name="system.attributes.{{key}}.manualModifier" value="{{manualModifier}}" step="1" aria-label="{{label}} — modyfikator ręczny"></td>{{/each}}<th scope="row">Modyfikator</th></tr>
          {{#each attributeDifficultyRows}}
            <tr class="ns-threshold-row {{#if average}}ns-average-difficulty{{/if}}">{{#each values}}<td><button type="button" class="ns-threshold" data-action="selectAttributeLevel" data-attribute="{{key}}" data-difficulty="{{../index}}" aria-pressed="false" aria-label="Wybierz: {{label}}, {{../label}}, próg {{value}}" title="{{label}} — {{../label}}">{{value}}</button></td>{{/each}}<th scope="row">{{label}} <small>({{modifier}})</small>{{#if average}}<small class="ns-final-caption">wartość końcowa</small>{{/if}}</th></tr>
          {{/each}}
        </tbody>
      </table>
      <div class="ns-selected-test"><span data-attribute-selection-label aria-live="polite">{{#if attributeTestSelection}}{{attributeTestSelection.label}}{{else}}Wybierz próg w tabeli{{/if}}</span><button type="button" data-action="rollSelectedAttribute" {{#unless attributeTestSelection}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> Rzuć 3k20</button></div>
      <p class="ns-reference-note">Zaznacz próg, a następnie rzuć kośćmi. Wybrany poziom jest bazą testu; kary i ułatwienia ustalasz w oknie rzutu.</p>
    </section>

    <section class="ns-panel ns-wounds-panel">
      <div class="ns-section-heading"><h2>Rany i obrażenia</h2><strong class="ns-wound-total">{{totalWoundPenaltyPercent}}%</strong></div>
      <div class="ns-wound-toolbar"><button type="button" data-action="rollInjury">Rzut na ranę</button><span>Obrażenia <strong>{{totalDamageValue}}</strong></span></div>
      <div class="ns-consciousness {{#if consciousness.hasPending}}ns-consciousness-pending{{/if}}">
        {{#if consciousness.unconscious}}<p><strong>Postać jest nieprzytomna.</strong> Wybudzenie ustal z MG; status można zdjąć z tokena.</p>{{/if}}
        {{#if consciousness.hasPending}}
          <p><strong>Zachowanie przytomności — oczekuje na test</strong></p>
          <ul>{{#each consciousness.pending}}<li>{{reason}}{{#if injuryName}} — {{injuryName}}{{/if}}</li>{{/each}}</ul>
        {{/if}}
        {{#unless consciousness.unconscious}}<button type="button" data-action="rollConsciousness">{{#if consciousness.hasPending}}Rozpatrz zachowanie przytomności{{else}}Test zachowania przytomności{{/if}}</button>{{/unless}}
        <details data-sync="consciousness-rules"><summary>Kiedy wykonać test?</summary><p>Problematyczny test Budowy: rana ciężka, co najmniej lekka rana w głowę lub od czwartej lekkiej rany w jednej turze. Po ranie krytycznej: Cholernie trudny test Budowy. To reguła dodatkowa.</p><p>Lekkie rany liczymy w całej rundzie Trackera (3 segmenty). Poza walką użyj przycisku i wskaż powód. Test jest osobny od Odporności na ból.</p></details>
      </div>
      <div class="ns-body-map">
        <figure class="ns-body-figure">
          <img src="systems/neuroshima/assets/body-map.svg" alt="Sylwetka postaci; rany są pogrupowane według części ciała w sąsiednich polach.">
          <figcaption>LOKACJE RAN</figcaption>
        </figure>
        {{#each injuryLocations}}
          <section class="ns-body-location ns-location-{{key}} {{#if hasInjuries}}has-injuries{{/if}}" aria-label="{{label}}">
            <div class="ns-location-heading"><h3>{{label}}</h3><button type="button" data-action="createInjury" data-location="{{key}}" title="Dodaj ranę: {{label}}" aria-label="Dodaj ranę: {{label}}">+</button></div>
            {{#each items}}
              <div class="ns-location-injury">
                <button class="ns-injury-link" type="button" data-action="editInjury" data-item-id="{{id}}" title="{{name}} — {{injuryTypeName}}; obrażenia: {{damageValue}}">{{name}}</button>
                <span>{{penaltyPercent}}%</span>
                <div class="ns-injury-actions"><small>{{injuryTypeName}}</small><button type="button" data-action="treatInjury" data-item-id="{{id}}" aria-label="Opatrz: {{name}}">Opatrz</button><button type="button" class="ns-delete-injury" data-action="deleteInjury" data-item-id="{{id}}" aria-label="Usuń ranę: {{name}}" title="Usuń ranę całkowicie, niezależnie od jej kary">Usuń</button></div>
              </div>
            {{else}}<p class="ns-no-injuries">Brak ran</p>{{/each}}
            {{#if hasInjuries}}<div class="ns-location-total">Kara lokacji <strong>{{penaltyPercent}}%</strong></div>{{/if}}
          </section>
        {{/each}}
      </div>
    </section>
  </div>

  <details data-sync="modifiers" class="ns-panel ns-collapsible">
    <summary>Aktywne efekty i modyfikatory</summary>
  <button type="button" data-action="createModifier">Dodaj efekt</button>
  <button type="button" data-action="createCatalogModifier">Dodaj z Kompendium EFFECT</button>
  <p><small>Efekty mogą zmieniać Współczynnik, poziom Umiejętności albo procentową trudność wszystkich testów.</small></p>
  <div class="ns-table-scroll"><table>
    <thead>
      <tr>
        <th>Źródło</th>
        <th>Zakres</th>
        <th>Wartość</th>
        <th>Czas</th>
        <th>Stan</th>
        <th>Akcje</th>
      </tr>
    </thead>
    <tbody>
      {{#each modifierEntries}}
        <tr>
          <td>{{this.source}}</td>
          <td>{{this.scopeLabel}}</td>
          <td>{{this.valueLabel}}</td>
          <td>{{this.expiresLabel}}</td>
          <td>{{this.statusLabel}}</td>
          <td>
            {{#if this.editable}}
              <button type="button" data-action="editModifier" data-modifier-id="{{this.id}}">Edytuj</button>
              {{#if this.canToggle}}
                <button type="button" data-action="toggleModifier" data-modifier-id="{{this.id}}">{{#if this.enabled}}Wyłącz{{else}}Włącz{{/if}}</button>
              {{/if}}
              <button type="button" data-action="deleteModifier" data-modifier-id="{{this.id}}">Usuń</button>
            {{else}}
              Zmień źródłowy Item
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr><td colspan="6">Brak zapisanych efektów.</td></tr>
      {{/each}}
    </tbody>
  </table></div>
  </details>

  <details data-sync="injury-details" class="ns-panel ns-collapsible">
    <summary>Szczegóły ran i kara pancerza</summary>

  {{!-- Rany są osobnymi Itemami, dlatego ich liczba nie jest z góry ograniczona. --}}
  <div class="injuries">
    <button type="button" data-action="rollInjury">Rzut na ranę</button>
    <button type="button" data-action="createInjury">Dodaj ranę</button>

    <p><strong>Suma kar z ran:</strong> {{totalWoundPenaltyPercent}}%</p>
    <p><strong>Łączna wartość obrażeń:</strong> {{totalDamageValue}}</p>

    <label>
      Kara pancerza do testów
      <input type="number" name="system.testPenalties.armorPercent" value="{{system.testPenalties.armorPercent}}" min="0" step="1"> %
    </label>
    <small>Pole zgodności ze starszymi kartami. Jest używane tylko wtedy, gdy postać nie ma założonego Itemu pancerza.</small>

    <div class="ns-table-scroll"><table>
      <thead>
        <tr>
          <th>Rana</th>
          <th>Lokacja</th>
          <th>Rodzaj</th>
          <th>Obrażenia</th>
          <th>Kara</th>
          <th>Akcje</th>
        </tr>
      </thead>
      <tbody>
        {{#each injuryItems}}
          <tr>
            <td>{{this.name}}</td>
            <td>{{this.locationName}}</td>
            <td>{{this.injuryTypeName}}</td>
            <td>{{this.damageValue}}</td>
            <td>{{this.penaltyPercent}}%</td>
            <td>
              <button type="button" data-action="editInjury" data-item-id="{{this.id}}">Edytuj</button>
              <button type="button" data-action="treatInjury" data-item-id="{{this.id}}">Opatrz ranę</button>
              <button type="button" data-action="deleteInjury" data-item-id="{{this.id}}">Usuń</button>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="6">Postać nie ma jeszcze zapisanych ran.</td>
          </tr>
        {{/each}}
      </tbody>
    </table></div>
  </div>
  </details>
</section>
