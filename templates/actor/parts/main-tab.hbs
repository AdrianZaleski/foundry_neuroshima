<section class="tab {{tabs.main.cssClass}}" data-group="sheet" data-tab="main" style="height: calc(100% - 42px); overflow-y: auto; padding-right: 6px;">
  {{!-- Pole nie ma atrybutu name, więc zbiorczy formularz nie łączy go
  z drugim polem ksywy z zakładki Postać. Zapis wykonuje osobna akcja. --}}
  <header>
    <label>
      Ksywa
      <input type="text" value="{{actor.name}}" data-actor-name>
      <button type="button" data-action="saveActorName">Zapisz ksywę</button>
    </label>
  </header>

  <h2>Współczynniki</h2>

  {{!-- Każdy przycisk przekazuje do JavaScriptu klucz właściwego współczynnika. --}}
  <div class="attributes">
    <label>
      Zręczność bazowa
      <input type="number" name="system.attributes.zrecznosc.base" value="{{system.attributes.zrecznosc.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.zrecznosc.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="zrecznosc">Rzuć 3k20</button>

    <label>
      Percepcja bazowa
      <input type="number" name="system.attributes.percepcja.base" value="{{system.attributes.percepcja.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.percepcja.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="percepcja">Rzuć 3k20</button>

    <label>
      Charakter bazowy
      <input type="number" name="system.attributes.charakter.base" value="{{system.attributes.charakter.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.charakter.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="charakter">Rzuć 3k20</button>

    <label>
      Spryt bazowy
      <input type="number" name="system.attributes.spryt.base" value="{{system.attributes.spryt.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.spryt.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="spryt">Rzuć 3k20</button>

    <label>
      Budowa bazowa
      <input type="number" name="system.attributes.budowa.base" value="{{system.attributes.budowa.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.budowa.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="budowa">Rzuć 3k20</button>
  </div>

  <h2>Rany i utrudnienia</h2>

  {{!-- Rany są osobnymi Itemami, dlatego ich liczba nie jest z góry ograniczona. --}}
  <div class="injuries">
    <button type="button" data-action="createInjury">Dodaj ranę</button>

    <p><strong>Suma kar z ran:</strong> {{totalWoundPenaltyPercent}}%</p>
    <p><strong>Łączna wartość obrażeń:</strong> {{totalDamageValue}}</p>

    <label>
      Kara pancerza do testów
      <input type="number" name="system.testPenalties.armorPercent" value="{{system.testPenalties.armorPercent}}" min="0" step="1"> %
    </label>
    <small>Na tym etapie wpisujemy ją ręcznie. Później wyliczą ją założone elementy pancerza.</small>

    <table>
      <thead>
        <tr>
          <th>Rana</th>
          <th>Lokacja</th>
          <th>Rodzaj</th>
          <th>Obrażenia</th>
          <th>Kara</th>
          <th>Akcje</th>
        </tr>
      </thead>
      <tbody>
        {{#each injuryItems}}
          <tr>
            <td>{{this.name}}</td>
            <td>{{this.locationName}}</td>
            <td>{{this.injuryTypeName}}</td>
            <td>{{this.damageValue}}</td>
            <td>{{this.penaltyPercent}}%</td>
            <td>
              <button type="button" data-action="editInjury" data-item-id="{{this.id}}">Edytuj</button>
              <button type="button" data-action="deleteInjury" data-item-id="{{this.id}}">Usuń</button>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="6">Postać nie ma jeszcze zapisanych ran.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
