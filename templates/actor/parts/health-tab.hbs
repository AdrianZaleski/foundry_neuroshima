<section class="tab {{tabs.health.cssClass}}" data-group="sheet" data-tab="health" style="height: calc(100% - 42px); overflow-y: auto; padding-right: 6px;">
  <section>
    <h2>Gojenie — upływ czasu</h2>
    <button type="button" data-action="healOverTime">Rozlicz gojenie tej postaci</button>
    {{#if canManageDevelopmentSession}}<button type="button" data-action="healGroupOverTime">Rozlicz gojenie wielu postaci (MG)</button>{{/if}}
    <h2>Opatrywanie ran</h2>
    {{#each injuryItems}}
      <article><h3>{{this.name}} — {{this.locationName}}</h3>
        <p>{{this.injuryTypeName}}, kara {{this.penaltyPercent}}%.</p>
        {{#if this.stabilized}}<p>Rana krytyczna opatrzona. Pozostałe obrażenia i stan pacjenta ocenia MG.</p>{{/if}}
        <button type="button" data-action="treatInjury" data-item-id="{{this.id}}">Opatrz ranę</button>
        <details><summary>Historia zabiegów</summary>
          {{#each this.treatmentHistory}}<p>{{this.timestamp}} — {{this.healer}}, {{this.method}}: {{#if this.passed}}sukces{{else}}porażka{{/if}}. Kara {{this.before}}% → {{this.after}}%. Czas: {{this.duration}}.</p>
          {{else}}<p>Brak zabiegów.</p>{{/each}}
        </details>
        <details><summary>Historia gojenia</summary>
          {{#each this.healingHistory}}<p>{{this.timestamp}} — {{this.days}} dni, {{this.mode}}: {{this.before}}% → {{this.after}}%.</p>{{else}}<p>Brak rozliczonego gojenia.</p>{{/each}}
        </details>
      </article>
    {{else}}<p>Brak ran do opatrzenia.</p>{{/each}}
  </section>
  <h2>Choroby</h2>
  <button type="button" data-action="createDisease">Dodaj chorobę</button>

  {{#each diseaseItems}}
    <article class="disease">
      <h3>{{this.name}} — {{this.currentStageName}}</h3>
      {{#if this.currentStageSummary}}<p><strong>Zasady:</strong> {{this.currentStageSummary}}</p>{{/if}}
      {{#if this.currentStageDescription}}<p>{{this.currentStageDescription}}</p>{{/if}}
      {{#if this.currentStageEffect}}<p><small>Kod efektu: {{this.currentStageEffect}}</small></p>{{/if}}
      {{#if this.mechanicalEffects.length}}
        <p><strong>Zmiany aktualnego etapu:</strong></p>
        <ul>
          {{#each this.mechanicalEffects}}<li>{{this}}</li>{{/each}}
        </ul>
        <p><small>Wpływ na wyliczenia: {{#if this.mechanicalEffectsEnabled}}włączony{{else}}wyłączony{{/if}}</small></p>
      {{/if}}
      {{#if this.unsupportedEffects.length}}
        <p><small>Efekty opisowe: {{#each this.unsupportedEffects}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</small></p>
      {{/if}}
      {{#if this.linkedMedicines.length}}
        <p>
          <strong>Leki:</strong>
          {{#each this.linkedMedicines}}
            {{this.name}}{{#unless @last}}, {{/unless}}
          {{/each}}
        </p>
      {{else}}
        <p><strong>Leki:</strong> brak konkretnych pozycji w katalogu.</p>
      {{/if}}
      {{#if this.medicationDescription}}
        <details>
          <summary>Leczenie</summary>
          <p>{{this.medicationDescription}}</p>
        </details>
      {{/if}}
      <div>
        <button type="button" data-action="previousDiseaseStage" data-item-id="{{this.id}}" {{#unless this.canMoveBack}}disabled{{/unless}}>Poprzedni etap</button>
        <button type="button" data-action="nextDiseaseStage" data-item-id="{{this.id}}" {{#unless this.canMoveForward}}disabled{{/unless}}>Następny etap</button>
        <button type="button" data-action="toggleDiseaseEffects" data-item-id="{{this.id}}">{{#if this.mechanicalEffectsEnabled}}Wyłącz wpływ{{else}}Włącz wpływ{{/if}}</button>
        <button type="button" data-action="editDisease" data-item-id="{{this.id}}">Edytuj</button>
        <button type="button" data-action="deleteDisease" data-item-id="{{this.id}}">Usuń</button>
      </div>
    </article>
  {{else}}
    <p>Postać nie ma obecnie żadnej choroby.</p>
  {{/each}}

  <h2>Leki</h2>
  <button type="button" data-action="createMedicine">Dodaj lek</button>

  <table>
    <thead>
      <tr>
        <th>Lek</th>
        <th>Choroba</th>
        <th>Dawki</th>
        <th>Działanie</th>
        <th>Akcje</th>
      </tr>
    </thead>
    <tbody>
      {{#each medicineItems}}
        <tr>
          <td>
            <strong>{{this.name}}</strong><br>
            <small>Cena: {{this.price}}, dostępność: {{this.availability}}%</small>
          </td>
          <td>{{#if this.diseaseName}}{{this.diseaseName}}{{else}}Lek ogólny{{/if}}</td>
          <td>{{this.quantity}} / {{this.packageSize}}</td>
          <td>
            {{#if this.flavorText}}{{this.flavorText}}{{else}}Brak opisu działania{{/if}}
            {{#if this.effect}}<br><small>Kod efektu: {{this.effect}}</small>{{/if}}
            {{#if this.effectDurationHours}}<br><small>Czas: {{this.effectDurationHours}} godz.</small>{{/if}}
          </td>
          <td>
            <button type="button" data-action="consumeMedicine" data-item-id="{{this.id}}">Użyj dawki</button>
            <button type="button" data-action="editMedicine" data-item-id="{{this.id}}">Edytuj</button>
            <button type="button" data-action="deleteMedicine" data-item-id="{{this.id}}">Usuń</button>
          </td>
        </tr>
      {{else}}
        <tr><td colspan="5">Postać nie posiada jeszcze żadnych leków.</td></tr>
      {{/each}}
    </tbody>
  </table>
</section>
