<section class="tab {{tabs.details.cssClass}}" data-group="sheet" data-tab="details" style="height: calc(100% - 42px); overflow-y: auto; padding-right: 6px;">
  <h2>Dane postaci</h2>
  <label>Płeć postaci
    <select name="system.identity.gender">{{selectOptions genderOptions selected=system.identity.gender}}</select>
  </label>

  {{!-- Ksywa jest nazwą dokumentu Actor i dzięki temu pozostaje widoczna także poza kartą. --}}
  <label>
    Ksywa
    <input type="text" name="name" value="{{actor.name}}">
  </label>

  <label>
    Imię
    <input type="text" name="system.identity.firstName" value="{{system.identity.firstName}}">
  </label>

  <label>
    Nazwisko
    <input type="text" name="system.identity.lastName" value="{{system.identity.lastName}}">
  </label>

  <label>
    Pochodzenie z katalogu
    <select name="system.background.originSourceCode">
      {{selectOptions originOptions selected=system.background.originSourceCode}}
    </select>
  </label>

  <label>
    Własne pochodzenie
    <input type="text" name="system.background.origin" value="{{system.background.origin}}">
  </label>

  {{#if selectedOrigin}}
    <article>
      <h3>{{selectedOrigin.name}}</h3>
      {{#if selectedOrigin.bonus}}
        <p><strong>Bonus:</strong> {{selectedOrigin.bonus}}</p>
      {{/if}}
      <p>{{selectedOrigin.description}}</p>
    </article>
  {{/if}}

  {{#if chooseOriginBonus}}
    <label>Współczynnik z premią +1 za pochodzenie
      <select name="system.background.originBonusAttribute">
        {{selectOptions originBonusOptions selected=system.background.originBonusAttribute}}
      </select>
    </label>
  {{/if}}
  <p><small>Premia z katalogowego pochodzenia jest doliczana do wartości końcowej. Wartość bazową wpisz bez tej premii.</small></p>

  <label>
    Profesja z katalogu
    <select name="system.background.professionSourceCode">
      {{selectOptions professionOptions selected=system.background.professionSourceCode}}
    </select>
  </label>

  <label>
    Własna profesja
    <input type="text" name="system.background.profession" value="{{system.background.profession}}">
  </label>

  {{#if selectedProfession}}
    <article>
      <h3>{{selectedProfession.name}}</h3>
      {{#if selectedProfession.flavorText}}
        <p><em>{{selectedProfession.flavorText}}</em></p>
      {{/if}}
      <p>{{selectedProfession.description}}</p>
    </article>
  {{/if}}

  <label>
    Specjalizacja z katalogu
    <select name="system.background.specializationSourceCode">
      {{selectOptions specializationOptions selected=system.background.specializationSourceCode}}
    </select>
  </label>

  <label>
    Własna specjalizacja
    <input type="text" name="system.background.specialization" value="{{system.background.specialization}}">
  </label>

  {{#if selectedSpecialization}}
    <article>
      <h3>{{selectedSpecialization.name}}</h3>
      <p>{{selectedSpecialization.description}}</p>
    </article>
  {{/if}}

  <label>
    Punkty Doświadczenia
    <input type="number" name="system.development.experiencePoints" value="{{system.development.experiencePoints}}" min="0" step="1">
  </label>

  <section>
    <h3>Rozwój za PD</h3>
    <p>Rozliczenie po sesji {{system.development.session}}</p>
    <p>{{#if system.development.ignoreSessionLimit}}Limit podniesień po sesji wyłączony decyzją MG.{{else}}Limit: jedno podniesienie danej wartości po sesji.{{/if}}</p>
    {{#if canManageDevelopmentSession}}<button type="button" data-action="toggleDevelopmentSessionLimit">{{#if system.development.ignoreSessionLimit}}Przywróć limit podniesień (MG){{else}}Wyłącz limit podniesień (MG){{/if}}</button>{{/if}}
    <button type="button" data-action="purchaseDevelopment">Kup rozwój za PD</button>
    {{#if canManageDevelopmentSession}}<button type="button" data-action="nextDevelopmentSession">Kolejna sesja rozwoju (MG)</button>{{/if}}
    <details><summary>Historia rozwoju</summary>
      <table><thead><tr><th>Sesja</th><th>Rozwój</th><th>Poziom</th><th>Koszt PD</th><th>PD po zakupie</th></tr></thead>
        <tbody>{{#each developmentHistory}}<tr><td>{{this.session}}</td><td>{{this.label}}</td><td>{{this.from}} → {{this.to}}</td><td>{{this.cost}}</td><td>{{this.balanceAfter}}</td></tr>
        {{else}}<tr><td colspan="5">Brak zakupów rozwoju.</td></tr>{{/each}}</tbody>
      </table>
    </details>
  </section>

  <h2>Sztuczki</h2>
  <button type="button" data-action="createFeature" data-feature-type="perk">Dodaj sztuczkę</button>

  <table>
    <thead>
      <tr>
        <th>Nazwa</th>
        <th>Wymagania</th>
        <th>Działanie</th>
        <th>Akcje</th>
      </tr>
    </thead>
    <tbody>
      {{#each perkItems}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.requirements}}<p><strong>{{this.requirementStatus.label}}</strong></p><small>{{this.requirementStatus.details}}</small></td>
          <td>{{this.effects}}<p><small>{{this.automationStatus}}</small></p></td>
          <td>
            <button type="button" data-action="editFeature" data-item-id="{{this.id}}">Edytuj</button>
            <button type="button" data-action="deleteFeature" data-item-id="{{this.id}}">Usuń</button>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4">Postać nie posiada jeszcze żadnych sztuczek.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <h2>Cechy</h2>

  <button type="button" data-action="createFeature" data-feature-type="trait">Dodaj cechę</button>

  <table>
    <thead>
      <tr>
        <th>Nazwa</th>
        <th>Wymagania</th>
        <th>Działanie</th>
        <th>Akcje</th>
      </tr>
    </thead>
    <tbody>
      {{#each traitItems}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.requirements}}<p><strong>{{this.requirementStatus.label}}</strong></p><small>{{this.requirementStatus.details}}</small></td>
          <td>{{this.effects}}<p><small>{{this.automationStatus}}</small></p></td>
          <td>
            {{#if this.hasConditionalEffect}}
              <p>Działa do przespania nocy. Wyłącz efekt po ustaleniu tego w grze.</p>
              <button type="button" data-action="toggleConditionalFeature" data-item-id="{{this.id}}">{{#if this.conditionalEffectActive}}Wyłącz efekt{{else}}Włącz Umysł kupca{{/if}}</button>
            {{/if}}
            <button type="button" data-action="editFeature" data-item-id="{{this.id}}">Edytuj</button>
            <button type="button" data-action="deleteFeature" data-item-id="{{this.id}}">Usuń</button>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4">Postać nie posiada jeszcze żadnych cech.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <h2>Notatki</h2>

  <label>
    Opis i notatki postaci
    <textarea name="system.notes.character" rows="8">{{system.notes.character}}</textarea>
  </label>

  <label>
    Reputacja
    <textarea name="system.notes.reputation" rows="6">{{system.notes.reputation}}</textarea>
  </label>

  <label>
    Przyjaciele, znajomi i kontakty
    <textarea name="system.notes.contacts" rows="6">{{system.notes.contacts}}</textarea>
  </label>
</section>
