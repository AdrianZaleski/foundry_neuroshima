{{!-- Cała zawartość karty przewija się pionowo, gdy nie mieści się w oknie. --}}
<section class="neuroshima-character-sheet" style="height: 100%; overflow-y: auto; padding-right: 6px;">
  {{!-- Nazwa jest standardowym polem dokumentu Actor w Foundry. --}}
  <header>
    <label>
      Nazwa postaci
      <input type="text" name="name" value="{{actor.name}}">
    </label>
  </header>

  <h2>Współczynniki</h2>

  {{!-- Każdy przycisk przekazuje do JavaScriptu klucz właściwego współczynnika. --}}
  <div class="attributes">
    <label>
      Zręczność bazowa
      <input type="number" name="system.attributes.zrecznosc.base" value="{{system.attributes.zrecznosc.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.zrecznosc.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="zrecznosc">Rzuć 3k20</button>

    <label>
      Percepcja bazowa
      <input type="number" name="system.attributes.percepcja.base" value="{{system.attributes.percepcja.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.percepcja.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="percepcja">Rzuć 3k20</button>

    <label>
      Charakter bazowy
      <input type="number" name="system.attributes.charakter.base" value="{{system.attributes.charakter.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.charakter.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="charakter">Rzuć 3k20</button>

    <label>
      Spryt bazowy
      <input type="number" name="system.attributes.spryt.base" value="{{system.attributes.spryt.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.spryt.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="spryt">Rzuć 3k20</button>

    <label>
      Budowa bazowa
      <input type="number" name="system.attributes.budowa.base" value="{{system.attributes.budowa.base}}" min="1" max="40" step="1">
    </label>
    <output>Wartość końcowa: {{system.attributes.budowa.value}}</output>
    <button type="button" data-action="rollAttribute" data-attribute="budowa">Rzuć 3k20</button>
  </div>

  <h2>Umiejętności — Zręczność</h2>
  <h3>Walka wręcz</h3>

  {{!-- Na tym etapie edytujemy i zapisujemy poziomy umiejętności, ale jeszcze nimi nie rzucamy. --}}
  <div class="skills">
    <label>
      Bijatyka
      <input type="number" name="system.skills.bijatyka.base" value="{{system.skills.bijatyka.base}}" min="0" max="20" step="1">
    </label>
    <output>Wartość końcowa: {{system.skills.bijatyka.value}}</output>
    <button type="button" data-action="rollSkill" data-skill="bijatyka">Test umiejętności</button>

    <label>
      Broń ręczna
      <input type="number" name="system.skills.bronReczna.base" value="{{system.skills.bronReczna.base}}" min="0" max="20" step="1">
    </label>
    <output>Wartość końcowa: {{system.skills.bronReczna.value}}</output>
    <button type="button" data-action="rollSkill" data-skill="bronReczna">Test umiejętności</button>

    <label>
      Rzucanie
      <input type="number" name="system.skills.rzucanie.base" value="{{system.skills.rzucanie.base}}" min="0" max="20" step="1">
    </label>
    <output>Wartość końcowa: {{system.skills.rzucanie.value}}</output>
    <button type="button" data-action="rollSkill" data-skill="rzucanie">Test umiejętności</button>
  </div>
</section>
